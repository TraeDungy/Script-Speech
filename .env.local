# Script-Speech Environment Variables - Demo Mode

# ElevenLabs TTS API (optional - demo mode if not set)
ELEVENLABS_API_KEY=

# Stripe Payment Processing (optional - demo mode if not set)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Product/Price IDs (optional for demo)
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Stripe Webhook (optional for demo)
STRIPE_WEBHOOK_SECRET=

# App URLs
NEXT_PUBLIC_APP_URL=https://script-speech.vercel.app

# Supabase (optional - demo mode if not set)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Upstash Redis (optional - for demo)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenAI (optional - for demo)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-10-01
OPENAI_REALTIME_VOICE=alloy
