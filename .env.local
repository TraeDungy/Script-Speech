# Supabase configuration
SUPABASE_URL="https://your-supabase-url.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_KEY="your-supabase-optional-generic-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-url.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional Supabase table overrides
SUPABASE_ACCESS_REQUESTS_TABLE="access_requests"
SUPABASE_STORAGE_BUCKET="app-assets"
SUPABASE_STORAGE_FOLDER="public"
ASSET_SUPABASE_BUCKET="app-assets"
ASSET_SUPABASE_FOLDER="public"
EXPORT_STORAGE_BUCKET="exports"
EXPORT_STORAGE_FOLDER="jobs"

# Rate limiting (Upstash)
UPSTASH_REDIS_REST_URL="https://your-upstash-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Realtime / orchestration
OPENAI_API_KEY="your-openai-api-key"
OPENAI_REALTIME_MODEL="gpt-4o-realtime-preview"
OPENAI_REALTIME_VOICE="alloy"
ORCHESTRATION_BASE_URL="https://your-orchestration-service"
ORCHESTRATION_API_KEY="your-orchestration-api-key"
